# Account handle to scrape (without the @). The default 'archive' source only
# supports realDonaldTrump.
TARGET_HANDLE=realDonaldTrump

# Anthropic API key for --match llm (the default). Without it, matching falls
# back to the dictionary + name-block list. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Only needed if you use --source truthbrush (the no-account 'archive' source
# does NOT need these). Copy this file to .env to set them.
TRUTHSOCIAL_USERNAME=
TRUTHSOCIAL_PASSWORD=
